#!/usr/bin/env sh
# .githooks/pre-commit - block commits that contain secrets or .env files.
# Activated via: git config core.hooksPath .githooks
# (already done by scripts/install-hooks.sh / .ps1)

# Exit codes:
#   0 - all good, allow commit
#   1 - blocker, commit aborted
#
# To bypass intentionally (use with caution and only after a `да` from a human):
#   git commit --no-verify

set -e

red()    { printf "\033[31m%s\033[0m\n" "$*" >&2; }
yellow() { printf "\033[33m%s\033[0m\n" "$*" >&2; }
bold()   { printf "\033[1m%s\033[0m\n" "$*" >&2; }

# Files staged for commit (ACMR = Added/Copied/Modified/Renamed). Skip deletions.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
  exit 0
fi

FAILED=0

# 1. Block .env / secret files by path.
ENV_HITS=$(printf "%s\n" "$STAGED" | grep -E '(^|/)\.env($|\.|/)|(^|/)id_rsa($|\.)|\.pem$|\.key$|\.p12$|\.pfx$|secrets\.(yml|yaml|json)$' || true)
if [ -n "$ENV_HITS" ]; then
  bold ""
  red "[pre-commit] BLOCKED: попытка закоммитить файл с секретами:"
  printf "%s\n" "$ENV_HITS" | sed 's/^/  - /' >&2
  yellow "[pre-commit] Эти файлы должны быть в .gitignore. Не коммить их даже разово." >&2
  FAILED=1
fi

# 2. Scan content of staged text files for secret-like patterns.
# We use git diff --cached -U0 to look only at the lines being added.
ADDED_LINES=$(git diff --cached -U0 --no-color | grep -E '^\+[^+]' || true)

if [ -n "$ADDED_LINES" ]; then
  # Patterns aimed at common secrets. Designed to be specific enough to avoid
  # false positives on normal code (we look for typical key shapes / prefixes).
  PATTERNS='sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|gho_[A-Za-z0-9]{20,}|ghs_[A-Za-z0-9]{20,}|xox[abopr]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{20,}|-----BEGIN (RSA|OPENSSH|EC|DSA|PRIVATE) PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}'

  SECRET_HITS=$(printf "%s" "$ADDED_LINES" | grep -E "$PATTERNS" || true)

  if [ -n "$SECRET_HITS" ]; then
    bold ""
    red "[pre-commit] BLOCKED: в добавляемом коде найдены строки, похожие на секреты:"
    # Print only first 5 hits, and mask everything after the first 8 chars.
    printf "%s\n" "$SECRET_HITS" | head -n 5 | sed 's/\(.\{12\}\).*/\1***** (масштаб скрыт)/' | sed 's/^/  /' >&2
    yellow "[pre-commit] Если это ложное срабатывание — обсуди с пользователем." >&2
    yellow "[pre-commit] Если это правда секрет — ОТЗОВИ ключ и убери из stage." >&2
    FAILED=1
  fi
fi

if [ "$FAILED" -ne 0 ]; then
  bold ""
  yellow "[pre-commit] Подсказка: для убрать файл из коммита — git restore --staged <файл>" >&2
  yellow "[pre-commit] Подсказка: bypass только после явного 'да' от пользователя — git commit --no-verify" >&2
  bold ""
  exit 1
fi

exit 0
