{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/__pycache__": true,
    "**/*.log": true
  },

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    ".env.example": ".env,.env.*",
    "CLAUDE.md": "AGENTS.md,START_HERE.md",
    "README.md": "LICENSE"
  }
}
