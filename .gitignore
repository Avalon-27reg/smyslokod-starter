# --- Окружение и секреты ---
.env
.env.*
!.env.example

# --- OS ---
.DS_Store
Thumbs.db

# --- IDE ---
.idea
*.swp

# --- Логи ---
*.log

# --- Локальные настройки Claude Code (личное) ---
.claude/settings.local.json
.claude/scheduled_tasks.lock

# --- Стек-специфика (пере-зацепится после выбора стека) ---
# Когда вы выберете стек, добавьте сюда то, что не должно попадать в git.
# Примеры (раскомментируйте и/или дополните под свой стек):
#
# Node / pnpm / Next:
# node_modules
# .pnpm-store
# .next
# out
# .turbo
# *.tsbuildinfo
# .eslintcache
#
# Python:
# __pycache__
# *.pyc
# .venv
# venv
# .pytest_cache
# .mypy_cache
# .ruff_cache
# dist
# build
# *.egg-info
#
# Платформы деплоя:
# .vercel
# .netlify
